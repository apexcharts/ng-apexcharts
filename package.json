{
  "name": "ng-apexcharts-demo",
  "version": "1.0.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "test": "ng test --project ng-apexcharts",
    "test:schematics": "tsc -p ./projects/ng-apexcharts/schematics/tsconfig.spec.json --outDir dist/schematics-test && copyfiles -f ./projects/ng-apexcharts/schematics/collection.json ./dist/schematics-test && copyfiles -f ./projects/ng-apexcharts/schematics/ng-add/schema.json ./dist/schematics-test/ng-add && jasmine \"dist/schematics-test/**/*[sS]pec.js\"",
    "lint": "ng lint",
    "build:pkg": "ng build ng-apexcharts --configuration production",
    "postbuild:pkg": "npm run check:dts && npm run check:schematics-version",
    "check:dts": "node scripts/check-dts-leaks.js",
    "build:schematics": "tsc -p ./projects/ng-apexcharts/schematics/tsconfig.json --outDir dist/ng-apexcharts/schematics",
    "copyfile:license": "copyfiles ./LICENSE ./dist/ng-apexcharts",
    "copyfile:schema": "copyfiles -f ./projects/ng-apexcharts/schematics/ng-add/schema.json ./dist/ng-apexcharts/schematics/ng-add",
    "copyfile:collection": "copyfiles -f ./projects/ng-apexcharts/schematics/collection.json ./dist/ng-apexcharts/schematics",
    "copyfile": "concurrently -c cyan,green 'npm run copyfile:*'",
    "package": "npm run build:pkg && npm run build:schematics && npm run copyfile && npm run check:package",
    "update-lib-version": "node scripts/update-lib-version.js",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "check:schematics-version": "node scripts/check-schematics-version.js",
    "postbuild:schematics": "node scripts/write-schematics-type.js",
    "copyfile:readme": "copyfiles -f ./README.md ./dist/ng-apexcharts",
    "check:package": "node scripts/check-package.js"
  },
  "license": "See License in LICENSE",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/animations": "~22.0.1",
    "@angular/common": "~22.0.1",
    "@angular/compiler": "~22.0.1",
    "@angular/core": "~22.0.1",
    "@angular/forms": "~22.0.1",
    "@angular/platform-browser": "~22.0.1",
    "@angular/platform-browser-dynamic": "~22.0.1",
    "@angular/platform-server": "~22.0.1",
    "@angular/router": "~22.0.1",
    "@angular/ssr": "~22.0.1",
    "@schematics/angular": "~22.0.1",
    "apexcharts": "^6.7.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "20.6.0",
    "@angular-eslint/eslint-plugin": "20.6.0",
    "@angular-eslint/eslint-plugin-template": "20.6.0",
    "@angular-eslint/schematics": "20.6.0",
    "@angular-eslint/template-parser": "20.6.0",
    "@angular/build": "~22.0.1",
    "@angular/cli": "~22.0.1",
    "@angular/compiler-cli": "~22.0.1",
    "@angular/language-service": "~22.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^9.0.0",
    "@semantic-release/npm": "^13.1.3",
    "@semantic-release/release-notes-generator": "^12.0.0",
    "@types/express": "^5.0.6",
    "@types/jasmine": "^5.1.8",
    "@types/node": "~22.15.30",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "concurrently": "^9.2.4",
    "copyfiles": "^2.4.1",
    "eslint": "^9.28.0",
    "jasmine": "^5.13.0",
    "jasmine-core": "^5.11.0",
    "jasmine-spec-reporter": "~7.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "less": "^4.2.0",
    "ng-packagr": "~22.0.1",
    "semantic-release": "^25.0.2",
    "semver": "^7.7.3",
    "ts-node": "~10.9.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "karma-jasmine": {
      "jasmine-core": "^5.0.0"
    },
    "@angular-devkit/schematics": "22.0.7",
    "@angular-devkit/core": "22.0.7"
  }
}
